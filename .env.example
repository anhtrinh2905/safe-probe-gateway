# Copy to .env. `scripts/up.sh` generates PROBE_API_KEY if it is still empty.
# .env is gitignored; this file must never hold a real value.

# Credential the probing tool presents to the gateway. The gateway reads the
# same variable to build its consumer table, so the key exists in exactly two
# places: this process' environment, and the gateway's.
PROBE_API_KEY=

# Where the tool sends everything. There is no other reachable address --
# the targets publish no ports (see docker-compose.yml).
GATEWAY_URL=http://localhost:8000

# LLM layer (src/safe_probe/plan.py). Optional: the tool and the suite run
# without it. Same gateway as week 3.
CUSTOM_SCAN_MODEL=deepseek-v4-pro
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
